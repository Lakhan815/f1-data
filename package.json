{
  "name": "f1-data",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
    "build:gp": "esbuild scripts/jolpica-ingest-gp.ts --bundle --platform=node --format=esm --outfile=dist/gp/index.mjs --external:@prisma/client --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:sprint": "esbuild scripts/jolpica-ingest-sprint.ts --bundle --platform=node --outfile=dist/sprint/index.js --external:@prisma/client",
    "build:quali": "esbuild scripts/jolpica-ingest-quali.ts --bundle --platform=node --outfile=dist/quali/index.js --external:@prisma/client",
    "build:lambda": "npm run build:gp && npm run build:sprint && npm run build:quali"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
